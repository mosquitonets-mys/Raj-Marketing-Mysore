rules_version = '2';

// ============================================================
// RAJ MARKETING MYSORE — FIRESTORE SECURITY RULES v3.0
// ============================================================
// Fixes applied:
// 1. isApprovedDealer() now checks exists() before get()
// 2. Orders/Estimates create validates customerId == auth.uid
// 3. adminSessions locked to backend only
// 4. Visitor/feedback/appLog/enquiry writes have schema validation
// 5. Notifications require owner check
// 6. Order status validation matches app enums
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // FIXED: Check doc exists before .data.status
    function isApprovedDealer() {
      let dealerPath = /databases/$(database)/documents/dealers/$(request.auth.uid);
      return isSignedIn() &&
             exists(dealerPath) &&
             get(dealerPath).data.status == 'Approved';
    }

    function isCustomer() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ============================================================
    // VALIDATION HELPERS
    // ============================================================

    function isValidString(value, minLen, maxLen) {
      return value is string &&
             value.size() >= minLen &&
             value.size() <= maxLen;
    }

    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isValidMobile(value) {
      return value is string &&
             value.matches('^[6-9][0-9]{9}$');
    }

    function onlyUpdatedFields(fields) {
      return request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(fields);
    }

    // Prevent spam: rate-limit signature (basic length check)
    function isValidFeedback(data) {
      return data.keys().hasOnly(['name', 'email', 'message', 'rating', 'source', 'createdAt']) &&
             isValidString(data.name, 2, 100) &&
             isValidString(data.message, 5, 2000) &&
             (!('rating' in data) || isValidNumber(data.rating, 1, 5));
    }

    function isValidEnquiry(data) {
      return data.keys().hasAny(['name', 'mobile', 'message']) &&
             isValidString(data.name, 2, 100) &&
             isValidMobile(data.mobile) &&
             (!('message' in data) || isValidString(data.message, 0, 2000));
    }

    // ============================================================
    // CUSTOMERS
    // ============================================================
    match /customers/{customerId} {

      allow read: if isOwner(customerId) || isAdmin();

      // FIXED: validate all required fields
      allow create: if isOwner(customerId) &&
                       request.resource.data.uid == request.auth.uid &&
                       isValidString(request.resource.data.name, 2, 100) &&
                       isValidString(request.resource.data.email, 5, 100) &&
                       isValidMobile(request.resource.data.mobile);

      allow update: if isAdmin() ||
                       (isOwner(customerId) &&
                        request.resource.data.uid == resource.data.uid); // uid immutable

      allow delete: if isAdmin();
    }

    // ============================================================
    // DEALERS
    // ============================================================
    match /dealers/{dealerId} {

      allow read: if isOwner(dealerId) || isAdmin();

      // Dealer self-registration — status must be 'Pending'
      allow create: if isOwner(dealerId) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == 'Pending' &&
                       isValidString(request.resource.data.ownerName, 2, 100) &&
                       isValidString(request.resource.data.businessName, 2, 150) &&
                       isValidMobile(request.resource.data.mobile);

      // Owner can update profile only — NOT status/tier
      allow update: if isAdmin() ||
                       (isOwner(dealerId) &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly([
                            'ownerName', 'businessName', 'mobile',
                            'whatsapp', 'gst', 'address', 'city',
                            'pincode', 'updatedAt'
                          ]));

      allow delete: if isAdmin();
    }

    // ============================================================
    // PRODUCTS — public read, admin write
    // ============================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // PRICE LIST
    // ============================================================
    match /priceList/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ORDERS
    // ============================================================
    match /orders/{orderId} {

      allow read: if isAdmin() ||
                     isApprovedDealer() ||
                     (isSignedIn() && resource.data.customerId == request.auth.uid);

      // FIXED: enforce ownership + valid status enum
      // Accept both 'NEW' and 'PENDING' (app uses both historically)
      allow create: if isSignedIn() &&
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.status in ['NEW', 'PENDING'] &&
                       request.resource.data.paymentStatus in ['PENDING', 'UNPAID'];

      // Customer can only cancel their own order
      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.customerId == request.auth.uid &&
                        onlyUpdatedFields(['status', 'cancelledAt', 'cancelReason', 'updatedAt']) &&
                        request.resource.data.status == 'CANCELLED') ||
                       (isApprovedDealer() &&
                        resource.data.dealerId == request.auth.uid &&
                        onlyUpdatedFields(['status', 'statusUpdatedAt', 'statusNote', 'timeline', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ============================================================
    // CARTS — one doc per user, keyed by uid
    // ============================================================
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ============================================================
    // ESTIMATES
    // ============================================================
    match /estimates/{estimateId} {

      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.customerId == request.auth.uid) ||
                     (isSignedIn() && resource.data.dealerId == request.auth.uid);

      // FIXED: customer OR dealer must own the record being created
      allow create: if isSignedIn() &&
                       (request.resource.data.customerId == request.auth.uid ||
                        request.resource.data.dealerId == request.auth.uid);

      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.customerId == request.auth.uid ||
                         resource.data.dealerId == request.auth.uid));

      allow delete: if isAdmin();
    }

    // ============================================================
    // ENQUIRIES — public form, admin read
    // ============================================================
    match /enquiries/{enquiryId} {

      allow read: if isAdmin() ||
                     (isApprovedDealer() && resource.data.dealerId == request.auth.uid);

      // FIXED: schema validation prevents spam
      allow create: if isValidEnquiry(request.resource.data);

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // PAYMENTS — backend only
    // ============================================================
    match /payments/{paymentId} {

      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.customerId == request.auth.uid) ||
                     (isApprovedDealer() && resource.data.dealerId == request.auth.uid);

      // Only Cloud Functions (admin SDK) should create payments
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ============================================================
    // NOTIFICATIONS
    // ============================================================
    match /notifications/{notifId} {

      allow read: if isAdmin() ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      // FIXED: users can only create notifications for themselves,
      // OR admin can create for anyone
      allow create: if isAdmin() ||
                       (isSignedIn() &&
                        request.resource.data.userId == request.auth.uid);

      allow update: if isAdmin() ||
                       (isSignedIn() &&
                        resource.data.userId == request.auth.uid &&
                        onlyUpdatedFields(['read']));

      allow delete: if isAdmin();
    }

    // ============================================================
    // FEEDBACK — public submit with validation
    // ============================================================
    match /feedback/{feedbackId} {

      // FIXED: schema validation
      allow create: if isValidFeedback(request.resource.data);

      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // BUSINESS RULES — admin config
    // ============================================================
    match /businessRules/{ruleId} {

      // Exception: adminAuth sub-doc is NOT publicly readable
      allow read: if ruleId == 'adminAuth' ? isAdmin() : true;
      allow write: if isAdmin();
    }

    // ============================================================
    // ADMINS — list of admin UIDs (managed manually in console)
    // ============================================================
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;   // Only set manually in Firebase Console
    }

    // ============================================================
    // ADMIN SESSIONS — 🔒 FULLY LOCKED
    // FIXED: Removed `if true` — no client access at all
    // ============================================================
    match /adminSessions/{sessionId} {
      allow read, write: if false;   // Only Admin SDK (backend) can access
    }

    // ============================================================
    // VISITOR STATS
    // ============================================================
    match /visitorStats/{date} {

      allow read: if isAdmin();

      // FIXED: only allow incrementing known counter fields
      allow create: if request.resource.data.keys()
                       .hasOnly(['date', 'count', 'createdAt', 'updatedAt']);

      allow update: if request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['count', 'updatedAt']);

      allow delete: if isAdmin();
    }

    // ============================================================
    // APP LOGS
    // ============================================================
    match /appLogs/{logId} {

      allow read: if isAdmin();

      // FIXED: schema validation, prevent arbitrary data
      allow create: if request.resource.data.keys()
                       .hasOnly(['level', 'message', 'source', 'userId', 'createdAt']) &&
                       isValidString(request.resource.data.message, 1, 1000);

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
